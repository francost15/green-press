---
// The bar is animated by CSS scroll-driven animation (`animation-timeline: scroll()`
// in index.css). The script is only a fallback for browsers without it.
---

<div class="scroll-progress fixed top-0 right-0 left-0 z-[100] origin-left" aria-hidden="true">
</div>

<script>
  const supportsScrollTimeline =
    typeof CSS !== "undefined" && CSS.supports("animation-timeline: scroll()");

  if (!supportsScrollTimeline) {
    const bar = document.querySelector<HTMLElement>(".scroll-progress");
    if (bar) {
      bar.style.animation = "none";
      let ticking = false;
      const update = () => {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        const progress = total > 0 ? window.scrollY / total : 0;
        bar.style.transform = `scaleX(${progress})`;
        ticking = false;
      };
      window.addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        },
        { passive: true },
      );
      update();
    }
  }
</script>
