---
import Icon from "./Icon.astro";
import { profile } from "../data/profile";
import { localePath, otherLang, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  /**
   * Path of the equivalent page in the other locale, below its locale root. Defaults to
   * the locale home page — a project page must pass its own translated slug, otherwise
   * switching language would drop the reader back on the home page.
   */
  altPath?: string;
}

const { lang, altPath = "" } = Astro.props;

const navLinks = [
  { href: "#proyectos", es: "Proyectos", en: "Projects" },
  { href: "#experiencia", es: "Experiencia", en: "Experience" },
  { href: "#contacto", es: "Contacto", en: "Contact" },
];

const label = (link: (typeof navLinks)[number]) => (lang === "es" ? link.es : link.en);

// Section anchors only resolve on the home page; everywhere else they need to jump back
// to it first, or the nav silently does nothing.
const home = localePath(lang);
const isHome = Astro.url.pathname === home;
const anchor = (hash: string) => (isHome ? hash : `${home}${hash.replace(/^\//, "")}`);

const alt = otherLang(lang);
const altHref = localePath(alt, altPath);
const altLabel = alt.toUpperCase();
const altTitle = lang === "es" ? "Switch to English" : "Cambiar a Español";
const menuOpenLabel = lang === "es" ? "Abrir menú" : "Open menu";
const menuCloseLabel = lang === "es" ? "Cerrar menú" : "Close menu";
---

{/* The masthead is a permanent ruled bar. It never translates out of view: the
    previous build hid it at page top while its links stayed in the tab order,
    so a keyboard user tabbed into four links sitting above the viewport. */}
<nav aria-label="Main navigation" class="site-nav fixed top-0 right-0 left-0 z-50">
  <div
    class="sheet flex items-center justify-between gap-4 hair-b py-3"
  >
    <a
      href={anchor("#inicio")}
      class="nav-brand flex min-h-[44px] items-center"
    >
      {profile.name}
    </a>

    {/* Desktop nav. Same 900px cut as .cols, not Tailwind md (768). */}
    <div class="hidden items-center gap-6 min-[900px]:flex">
      {
        navLinks.map((link) => (
          <a
            href={anchor(link.href)}
            class="nav-link relative flex min-h-[44px] items-center text-[13px]"
          >
            {label(link)}
          </a>
        ))
      }

      <a
        href={profile.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-[44px] min-w-[44px] items-center justify-center"
        aria-label="GitHub"
      >
        <Icon name="GithubLogo" size={20} />
      </a>

      {/* The language switch is a real link to the other locale, not client state.
      */}
      <a
        href={altHref}
        data-lang-switch
        hreflang={alt}
        aria-label={altTitle}
        title={altTitle}
        class="lang-switch flex min-h-[44px] items-center gap-1.5 px-2 text-[13px] font-bold uppercase"
      >
        <Icon name="Translate" size={14} />
        <span class="flex w-6 justify-center">{altLabel}</span>
      </a>

    </div>

    {/* Mobile controls */}
    <div class="flex items-center gap-1 min-[900px]:hidden">
      <a
        href={altHref}
        data-lang-switch
        hreflang={alt}
        aria-label={altTitle}
        class="lang-switch flex min-h-[44px] min-w-[44px] items-center justify-center text-[13px] font-bold uppercase"
      >
        {altLabel}
      </a>
      <button
        type="button"
        data-menu-button
        class="flex h-11 w-11 items-center justify-center"
        aria-label={menuOpenLabel}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={menuOpenLabel}
        data-label-close={menuCloseLabel}
      >
        <span data-icon-open><Icon name="List" size={22} /></span>
        <span data-icon-close hidden><Icon name="X" size={22} /></span>
      </button>
    </div>
  </div>

  {/* Mobile menu */}
  <div
    id="mobile-menu"
    data-mobile-menu
    hidden
    class="hair-b bg-[var(--paper)] min-[900px]:hidden"
  >
    <div class="flex flex-col px-6 py-2">
      {
        navLinks.map((link) => (
          <a
            href={anchor(link.href)}
            class="nav-link flex min-h-[52px] items-center hair-b text-base uppercase"
          >
            {label(link)}
          </a>
        ))
      }
      <a
        href={profile.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-[52px] items-center text-base uppercase"
      >
        GitHub
      </a>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    background-color: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .site-nav { background-color: var(--paper); }
  }

  .nav-brand {
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    font-size: 14px;
  }

  .nav-link,
  .lang-switch {
    color: var(--mid);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover,
    .lang-switch:hover {
      color: var(--ink);
    }
  }

  /* The section in view is marked the way a specimen marks the live setting. */
  .nav-link[aria-current="page"] {
    color: var(--ink);
    font-weight: 600;
  }

  .site-nav > div .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 8px;
    height: 2px;
    background-color: var(--violet);
  }
</style>

<script>
  import { initNavbar } from "../scripts/navbar";

  initNavbar();
</script>
