---
// Decorative constellation canvas behind the hero.
---

<div class="absolute inset-0 w-full h-full overflow-hidden">
  <canvas data-hero-canvas aria-hidden="true" class="block w-full h-full"></canvas>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-canvas]");
  const ctx = canvas?.getContext("2d", { alpha: true });
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && ctx && !reduceMotion) {
    const root = document.documentElement;

    // Read as a mutable flag rather than re-initialising on theme change, so
    // toggling light/dark no longer scatters the constellation.
    let isDark = root.getAttribute("data-theme") === "dark";
    new MutationObserver(() => {
      isDark = root.getAttribute("data-theme") === "dark";
    }).observe(root, { attributes: true, attributeFilter: ["data-theme"] });

    let w = (canvas.width = window.innerWidth);
    let h = (canvas.height = window.innerHeight);

    const SHAPES = ["circle", "square", "triangle", "diamond"] as const;
    type Shape = (typeof SHAPES)[number];

    class Node {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      opacity: number;
      isCore: boolean;
      shape: Shape;
      rotation: number;
      vRotation: number;

      constructor(x: number, y: number, isCore = false) {
        this.x = x;
        this.y = y;
        this.isCore = isCore;
        this.size = isCore ? 5 : Math.random() * 2 + 1;
        this.opacity = isCore ? 1 : Math.random() * 0.5 + 0.1;
        this.vx = (Math.random() - 0.5) * 0.6;
        this.vy = (Math.random() - 0.5) * 0.6;
        this.shape = isCore ? "diamond" : SHAPES[Math.floor(Math.random() * SHAPES.length)];
        this.rotation = Math.random() * Math.PI * 2;
        this.vRotation = (Math.random() - 0.5) * 0.02;
      }

      update() {
        if (this.isCore) {
          this.rotation += 0.01;
          return;
        }
        this.x += this.vx;
        this.y += this.vy;
        this.rotation += this.vRotation;
        if (this.x < 0 || this.x > w) this.vx *= -1;
        if (this.y < 0 || this.y > h) this.vy *= -1;
      }

      draw() {
        ctx!.save();
        ctx!.translate(this.x, this.y);
        ctx!.rotate(this.rotation);
        ctx!.beginPath();

        if (this.isCore) {
          ctx!.fillStyle = `rgba(139, 92, 246, ${this.opacity})`;
          ctx!.shadowBlur = 20;
          ctx!.shadowColor = "rgba(139, 92, 246, 0.8)";
        } else {
          ctx!.fillStyle = isDark
            ? `rgba(255, 255, 255, ${this.opacity * 1.2})`
            : `rgba(20, 20, 20, ${this.opacity * 1.5})`;
          ctx!.shadowBlur = 0;
        }

        const s = this.size;
        if (this.shape === "circle") {
          ctx!.arc(0, 0, s, 0, Math.PI * 2);
        } else if (this.shape === "square") {
          ctx!.rect(-s, -s, s * 2, s * 2);
        } else if (this.shape === "triangle") {
          ctx!.moveTo(0, -s * 1.2);
          ctx!.lineTo(s * 1.2, s * 1.2);
          ctx!.lineTo(-s * 1.2, s * 1.2);
          ctx!.closePath();
        } else {
          ctx!.moveTo(0, -s * 1.5);
          ctx!.lineTo(s * 1.5, 0);
          ctx!.lineTo(0, s * 1.5);
          ctx!.lineTo(-s * 1.5, 0);
          ctx!.closePath();
        }

        ctx!.fill();
        ctx!.restore();
      }
    }

    const coreNode = new Node(w / 2, h / 2, true);
    const nodes: Node[] = [coreNode];
    for (let i = 0; i < 50; i++) nodes.push(new Node(Math.random() * w, Math.random() * h));

    const drawConnections = () => {
      const maxDist = 130;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const distance = Math.sqrt(dx * dx + dy * dy);
          if (distance >= maxDist) continue;

          const opacity = 1 - distance / maxDist;
          ctx.beginPath();
          ctx.moveTo(nodes[i].x, nodes[i].y);
          ctx.lineTo(nodes[j].x, nodes[j].y);

          if (nodes[i].isCore || nodes[j].isCore) {
            ctx.strokeStyle = `rgba(139, 92, 246, ${opacity * 0.9})`;
            ctx.lineWidth = 1.5;
          } else {
            ctx.strokeStyle = isDark
              ? `rgba(255, 255, 255, ${opacity * 0.3})`
              : `rgba(20, 20, 20, ${opacity * 0.15})`;
            ctx.lineWidth = 0.8;
          }
          ctx.stroke();
        }
      }
    };

    // Stop burning frames once the hero has scrolled away.
    let isVisible = true;
    new IntersectionObserver(([entry]) => (isVisible = entry.isIntersecting), {
      threshold: 0,
    }).observe(canvas);

    const render = () => {
      if (isVisible) {
        const now = Date.now();
        ctx.clearRect(0, 0, w, h);

        coreNode.x = w / 2 + Math.sin(now / 3000) * 30;
        coreNode.y = h / 2 + Math.cos(now / 2000) * 20;
        coreNode.size = 6 + Math.sin(now / 600) * 2;

        for (const node of nodes) {
          node.update();
          node.draw();
        }
        drawConnections();
      }
      requestAnimationFrame(render);
    };

    render();

    window.addEventListener("resize", () => {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
      coreNode.x = w / 2;
      coreNode.y = h / 2;
    });
  }
</script>
