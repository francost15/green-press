---
import Icon from "./Icon.astro";
---

{/* The knob position and colour are driven by CSS off html[data-theme], which the
    head script sets before first paint — so there is no flash and no server/client
    mismatch. The script below only handles the click and the aria state. */}
<button
  type="button"
  data-theme-toggle
  role="switch"
  aria-checked="false"
  aria-label="Toggle colour theme"
  class="relative h-8 w-14 rounded-full border border-border bg-bg-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
>
  <span
    class="theme-knob absolute top-0.5 left-px flex h-7 w-7 items-center justify-center rounded-full shadow-sm"
  >
    <span class="icon-light flex items-center justify-center">
      <Icon name="Sun" size={14} class="text-white" />
    </span>
    <span class="icon-dark flex items-center justify-center">
      <Icon name="Moon" size={14} class="text-white" />
    </span>
  </span>
</button>

<style>
  .theme-knob {
    background-color: var(--color-text-primary);
    transform: translateX(0);
    transition:
      transform 200ms ease,
      background-color 200ms ease;
  }

  .icon-dark {
    display: none;
  }

  :global(html[data-theme="dark"]) .theme-knob {
    background-color: var(--color-accent);
    transform: translateX(24px);
  }

  :global(html[data-theme="dark"]) .icon-light {
    display: none;
  }

  :global(html[data-theme="dark"]) .icon-dark {
    display: flex;
  }
</style>

<script>
  import { initThemeToggle } from "../scripts/theme";

  initThemeToggle();
</script>
