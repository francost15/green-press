---
import { uiIcons } from "../data/iconMarkup";

interface Props {
  name: keyof typeof uiIcons | string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const icon = uiIcons[name];

if (!icon) throw new Error(`Unknown icon: ${name}`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox={icon.viewBox}
  fill="currentColor"
  class={className}
  aria-hidden="true"
  set:html={icon.inner}
/>
