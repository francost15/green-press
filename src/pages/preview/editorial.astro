---
import PreviewLayout from "../../layouts/PreviewLayout.astro";
import { profile } from "../../data/profile";
import { projects } from "../../data/projects";
import { experience } from "../../data/experience";
import { education } from "../../data/education";
import { competencies } from "../../data/competencies";
import { formatPeriod } from "../../lib/dates";
import "../../styles/preview-editorial.css";

const nav = [
  { href: "#work", label: "Work" },
  { href: "#practice", label: "Practice" },
  { href: "#record", label: "Record" },
  { href: "#contact", label: "Contact" },
];
---

<PreviewLayout
  title="Editorial Rule"
  fonts={[{ family: "General Sans", file: "/fonts/general-sans-var.woff2" }]}
>
  <div class="grid-lines" aria-hidden="true">
    {Array.from({ length: 12 }).map(() => <span />)}
  </div>

  <header class="bar">
    <div class="sheet layer">
      <div class="bar-in">
        <a href="#top"><strong>Franco Sanchez</strong></a>
        <nav class="bar-nav">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <a href={profile.cvUrl} download>Curriculum vitae →</a>
      </div>
    </div>
  </header>

  <main id="top" class="sheet layer">
    {/* ── Masthead ─────────────────────────────────────────── */}
    <section class="band">
      <div class="cols">
        <div class="c-meta">
          <p class="t-meta mask d1"><span>AI &amp; Software Engineer</span></p>
        </div>
        <div class="c-main">
          <h1 class="t-display">
            <span class="mask d1"><span>Franco</span></span>{" "}
            <span class="mask d2"><span class="accent">Sanchez</span></span>
          </h1>
          <p class="t-sub mask d3" style="margin-top:2rem; max-width:26ch">
            <span>Systems that reach the production floor, and stay there.</span>
          </p>
        </div>
      </div>

      <div class="cols" style="margin-top: clamp(2.5rem, 5vw, 5rem)">
        <div class="c-meta">
          <p class="t-meta">Practice</p>
        </div>
        <div class="c-main">
          <p class="t-body mask d4">
            <span>
              I take AI systems from concept to the production floor and measure what they
              save. Textile plants, fiscal invoicing, university operations, recruitment —
              five systems running in real companies, not demos.
            </span>
          </p>
          <div style="display:flex; gap:.75rem; flex-wrap:wrap; margin-top:2.25rem">
            <a class="act" href={profile.cvUrl} download>Download CV</a>
            <a class="act act-ghost" href="#work">See the work</a>
          </div>
        </div>
      </div>
    </section>

    {/* ── Work ─────────────────────────────────────────────── */}
    <section class="band" id="work">
      <div class="cols in" style="margin-bottom: 3rem">
        <div class="c-meta"><p class="t-meta">01 — Work</p></div>
        <div class="c-main">
          <h2 class="t-head">Five systems in production</h2>
        </div>
      </div>

      <ul>
        {
          projects.map((p, i) => (
            <li class="row">
              <div class="row-n">
                <p class="t-meta">{String(i + 1).padStart(2, "0")}</p>
              </div>
              <div class="row-t">
                <h3 class="t-sub">
                  <a href={`/projects/${p.slug}/`}>{p.title.en}</a>
                </h3>
                <ul class="tags" style="margin-top:.85rem">
                  {p.tags.en.slice(0, 4).map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
              <div class="row-d">
                <p class="t-body" style="font-size:.95rem">{p.impact.en}</p>
              </div>
              <span class="row-mark" aria-hidden="true" />
            </li>
          ))
        }
      </ul>
    </section>

    {/* ── Practice ─────────────────────────────────────────── */}
    <section class="band" id="practice">
      <div class="cols in" style="margin-bottom: 3rem">
        <div class="c-meta"><p class="t-meta">02 — Practice</p></div>
        <div class="c-main"><h2 class="t-head">What I am hired to solve</h2></div>
      </div>

      {
        competencies.map((c) => (
          <div class="cols in" style="padding-block: 1.75rem; border-top: 1px solid var(--rule)">
            <div class="c-meta">
              <p class="t-meta">{c.techs.slice(0, 3).join(" · ")}</p>
            </div>
            <div class="c-main">
              <h3 class="t-sub">{c.title.en}</h3>
              <p class="t-body" style="margin-top:.6rem">{c.description.en}</p>
            </div>
          </div>
        ))
      }
    </section>

    {/* ── Record ───────────────────────────────────────────── */}
    <section class="band" id="record">
      <div class="cols in" style="margin-bottom: 3rem">
        <div class="c-meta"><p class="t-meta">03 — Record</p></div>
        <div class="c-main"><h2 class="t-head">Where the work was done</h2></div>
      </div>

      <ul>
        {
          experience.map((e) => (
            <li class="row">
              <div class="row-n">
                <p class="t-meta">{formatPeriod(e.period, "en")}</p>
              </div>
              <div class="row-t">
                <h3 class="t-sub">{e.role.en}</h3>
                <p class="t-meta" style="margin-top:.5rem; text-transform:none; letter-spacing:0">
                  {e.company}
                </p>
              </div>
              <div class="row-d">
                <p class="t-body" style="font-size:.95rem">{e.description.en}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="cols in" style="margin-top: 4rem">
        <div class="c-meta"><p class="t-meta">Education</p></div>
        <div class="c-main">
          <ul style="display:grid; gap:1.1rem">
            {
              education.map((e) => (
                <li>
                  <h3 class="t-sub" style="font-size:1.05rem">
                    {e.degree.en}
                    {e.status === "in-progress" && <span class="accent"> · in progress</span>}
                  </h3>
                  <p class="t-meta" style="margin-top:.3rem; text-transform:none; letter-spacing:0">
                    {e.institution} — {formatPeriod(e.period, "en")}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* ── Contact ──────────────────────────────────────────── */}
    <section class="band" id="contact">
      <div class="cols in">
        <div class="c-meta"><p class="t-meta">04 — Contact</p></div>
        <div class="c-main">
          <h2 class="t-head">
            Open to full-time roles<br />and contract work.
          </h2>
          <div style="display:flex; gap:.75rem; flex-wrap:wrap; margin-top:2.5rem">
            <a class="act" href={`mailto:${profile.email}`}>{profile.email}</a>
            <a class="act act-ghost" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
              LinkedIn
            </a>
            <a class="act act-ghost" href={profile.links.github} target="_blank" rel="noopener noreferrer">
              GitHub
            </a>
          </div>
          <p class="t-meta" style="margin-top:3.5rem">
            {profile.location} · Español · English
          </p>
        </div>
      </div>
    </section>
  </main>
</PreviewLayout>
