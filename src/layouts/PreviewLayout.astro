---
/**
 * Isolated shell for the design previews. It deliberately does NOT import
 * `src/index.css`, so a variant can carry its own complete visual system with
 * no chance of leaking into — or inheriting from — the production world.
 *
 * Previews are noindex: they must never enter the GEO surface the real site
 * is being tuned for.
 */
interface Props {
  title: string;
  /** Variant stylesheet, imported by the page itself. */
  fonts: { family: string; file: string }[];
}

const { title, fonts } = Astro.props;

const variants = [
  { href: "/preview/editorial/", label: "Editorial Rule" },
  { href: "/preview/", label: "Index" },
  { href: "/preview/stage/", label: "Stage" },
];

const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — preview</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      fonts.map((f) => (
        <link rel="preload" href={f.file} as="font" type="font/woff2" crossorigin />
      ))
    }
  </head>
  <body>
    <slot />

    {/* Variant switcher. Preview-only chrome, never part of a variant. */}
    <nav class="pv-switch" aria-label="Design previews">
      {
        variants.map((v) => (
          <a href={v.href} aria-current={here === v.href ? "page" : undefined}>
            {v.label}
          </a>
        ))
      }
    </nav>

    <style is:global>
      .pv-switch {
        position: fixed;
        bottom: 1rem;
        left: 50%;
        translate: -50% 0;
        z-index: 9999;
        display: flex;
        gap: 2px;
        padding: 3px;
        background: #101014;
        border-radius: 999px;
        font-family: ui-sans-serif, system-ui, sans-serif;
        font-size: 12px;
        letter-spacing: 0.02em;
        box-shadow: 0 8px 30px -8px rgb(0 0 0 / 0.4);
      }

      .pv-switch a {
        padding: 0.5rem 0.9rem;
        border-radius: 999px;
        color: #a1a1aa;
        text-decoration: none;
        white-space: nowrap;
      }

      .pv-switch a:hover { color: #fff; }

      .pv-switch a[aria-current="page"] {
        background: #fff;
        color: #101014;
      }

      @media print { .pv-switch { display: none; } }
    </style>
  </body>
</html>
