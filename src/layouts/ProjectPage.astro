---
import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { imageSizes, smallVariant } from "../data/imageSizes";
import { profile } from "../data/profile";
import type { Project } from "../data/projects";
import { SITE, localePath, useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
const t = useTranslations(lang);

const tags = lang === "es" ? project.tags.es : project.tags.en;
const images = project.images ?? [];

const indexPath = lang === "es" ? "proyectos/" : "projects/";
const path = `${indexPath}${project.slug}/`;
const altPath = `${lang === "es" ? "projects/" : "proyectos/"}${project.slug}/`;

// localePath supplies the leading slash; `${SITE}${path}` would concatenate into
// "https://fsanchezt.comprojects/…".
const canonicalUrl = `${SITE}${localePath(lang, path)}`;

const title = t(project.title.es, project.title.en);
const description = t(project.impact.es, project.impact.en);
const contactHash = "#contacto";

// One CreativeWork per page, bound to the shared Person node — the home page's ItemList
// stays where it is and is not repeated here.
const schema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${canonicalUrl}#project`,
  name: title,
  headline: title,
  description,
  url: canonicalUrl,
  inLanguage: lang,
  creator: { "@id": `${SITE}/#person` },
  author: { "@id": `${SITE}/#person` },
  keywords: tags.join(", "),
  ...(images.length > 0 ? { image: images.map((src) => `${SITE}${src}`) } : {}),
};

const sections = [
  { title: t("Problema", "The problem"), body: t(project.problem.es, project.problem.en) },
  { title: t("Solución", "The solution"), body: t(project.solution.es, project.solution.en) },
];
---

<BaseLayout
  lang={lang}
  title={`${title} — Franco Sanchez`}
  description={description}
  path={path}
  altPath={altPath}
  schemas={[schema]}
>
  <a href="#project-title" class="skip-link">{t("Saltar al contenido", "Skip to content")}</a>
  <Navbar lang={lang} altPath={altPath} />

  <main class="sheet layer pt-32 pb-24">
      <a href={localePath(lang)} class="link inline-flex items-center gap-2 text-[15px] font-semibold">
        <Icon name="CaretLeft" size={15} />
        {t("Volver al inicio", "Back to home")}
      </a>

      <div class="cols mt-10">
        {/* The margin annotates the entry: impact first, because it is the most
            citable sentence on the page, then the stack. */}
        <div class="c-meta order-2 min-[900px]:order-1">
          <p class="t-meta">{t("Impacto", "Impact")}</p>
          <p class="m-0 mt-1 max-w-[34ch] text-[15px] font-medium leading-snug">{description}</p>

          <p class="t-meta mt-7">{t("Stack", "Stack")}</p>
          <ul class="tags mt-2">
            {tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </div>

        <div class="c-main order-1 min-[900px]:order-2">
          <h1 id="project-title" class="t-head">{title}</h1>

          {
            sections.map((section) => (
              <section class="mt-10">
                <h2 class="t-sub">{section.title}</h2>
                <p class="t-body mt-4">{section.body}</p>
              </section>
            ))
          }

          {
            images.length > 0 && (
              <section class="mt-14">
                <h2 class="t-sub">{t("Capturas", "Screenshots")}</h2>
                {/* The setting column measures 800px on the 1320 sheet, so
                    desktop selects the 1536w candidate at 2x density. */}
                <div class="mt-6 flex flex-col gap-6">
                  {images.map((src, i) => (
                    <img
                      src={src}
                      srcset={`${smallVariant(src)} 768w, ${src} 1536w`}
                      sizes="(max-width: 900px) 100vw, 800px"
                      alt={`${title} — ${t("captura", "screenshot")} ${i + 1}`}
                      width={imageSizes[src]?.width}
                      height={imageSizes[src]?.height}
                      loading={i === 0 ? "eager" : "lazy"}
                      decoding="async"
                      class="img-reveal h-auto w-full border border-[var(--rule)]"
                    />
                  ))}
                </div>
              </section>
            )
          }

          {
            (project.github || project.link) && (
              <div class="hair-t mt-14 flex items-center gap-6 pt-6">
                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link inline-flex min-h-[44px] items-center gap-2 text-[15px] font-semibold"
                  >
                    <Icon name="GithubLogo" size={17} /> GitHub
                  </a>
                )}
                {project.link && (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link inline-flex min-h-[44px] items-center gap-2 text-[15px] font-semibold"
                  >
                    <Icon name="ArrowSquareOut" size={17} /> {t("Demo en vivo", "Live demo")}
                  </a>
                )}
              </div>
            )
          }
          {/* A project page used to end here, with no way forward. */}
          <div class="hair-t mt-16 flex flex-wrap items-center gap-3 pt-8">
            <a href={profile.cvUrl} download class="act">
              <Icon name="DownloadSimple" size={18} />
              {t("Descargar CV", "Download CV")}
            </a>
            <a href={localePath(lang, contactHash)} class="act act-ghost">
              {t("Escríbeme", "Get in touch")}
              <Icon name="ArrowRight" size={18} />
            </a>
          </div>
        </div>
      </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
