---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { websiteSchema } from "../data/structuredData";
import { localePath, useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const path = lang === "es" ? "privacidad/" : "privacy/";
const altPath = lang === "es" ? "privacy/" : "privacidad/";
---

<BaseLayout
  lang={lang}
  title={t("Aviso de privacidad - Franco Sanchez", "Privacy notice - Franco Sanchez")}
  description={t(
    "Cómo se tratan nombre, correo y mensaje enviados por el formulario de contacto de fsanchezt.com.",
    "How name, email, and message from the fsanchezt.com contact form are handled.",
  )}
  path={path}
  altPath={altPath}
  schemas={[websiteSchema()]}
>
  <a href="#aviso" class="skip-link">{t("Saltar al contenido", "Skip to content")}</a>
  <Navbar lang={lang} altPath={altPath} />
  <main class="sheet layer pt-32 pb-24">
    <div class="cols">
      <p class="t-meta c-meta">{t("LFPDPPP", "Privacy")}</p>
      <article class="c-main" id="aviso">
        <h1 class="t-head" id="aviso">{t("Aviso de privacidad", "Privacy notice")}</h1>
        <p class="t-body mt-6">
          {t(
            "Aviso simplificado para el formulario de fsanchezt.com, conforme a la LFPDPPP.",
            "Short notice for the fsanchezt.com contact form, under Mexico's LFPDPPP.",
          )}
        </p>

        <h2 class="t-sub mt-10">{t("Responsable", "Controller")}</h2>
        <p class="t-body mt-3">
          {t(
            "Franco Alessandro Sanchez Trinidad, persona física, en Puebla, México. Correo: contacto@fsanchezt.dev. Sitio: https://www.fsanchezt.com.",
            "Franco Alessandro Sanchez Trinidad, an individual, in Puebla, Mexico. Email: contacto@fsanchezt.dev. Site: https://www.fsanchezt.com.",
          )}
        </p>

        <h2 class="t-sub mt-10">{t("Datos que recabo", "Data I collect")}</h2>
        <p class="t-body mt-3">
          {t(
            "Solo lo que escribes en el formulario: nombre, correo y mensaje. No pido datos sensibles, fiscales, de salud ni de tarjeta.",
            "Only what you type in the form: name, email, and message. I do not ask for sensitive, tax, health, or card data.",
          )}
        </p>

        <h2 class="t-sub mt-10">{t("Para qué", "Purpose")}</h2>
        <p class="t-body mt-3">
          {t(
            "Para responder una consulta sobre un proyecto de software o de inteligencia artificial. No uso estos datos para publicidad, no los vendo y no armo un perfil con ellos.",
            "To reply to a question about a software or AI project. I do not use this data for advertising, I do not sell it, and I do not build a profile from it.",
          )}
        </p>

        <h2 class="t-sub mt-10">{t("Quién más los ve", "Who else sees it")}</h2>
        <p class="t-body mt-3">
          {t(
            "El envío va por HTTPS a Formspree (formspree.io), que lo entrega a mi correo. Formspree trata el mensaje fuera de México. Al enviar, aceptas esa transferencia. No hay otros encargados.",
            "The message goes over HTTPS to Formspree (formspree.io), which delivers it to my mailbox. Formspree processes it outside Mexico. Sending the form means you accept that transfer. There are no other processors.",
          )}
        </p>

        <h2 class="t-sub mt-10">{t("Cuánto tiempo", "How long")}</h2>
        <p class="t-body mt-3">
          {t(
            "El tiempo necesario para contestarte. Si el mensaje se convierte en un encargo, mientras dure esa relación y el plazo que la ley pida para conservar documentos.",
            "As long as needed to reply. If the message becomes an engagement, for that relationship and for any period the law requires records to be kept.",
          )}
        </p>

        <h2 class="t-sub mt-10">{t("Tus derechos", "Your rights")}</h2>
        <p class="t-body mt-3">
          {t(
            "Puedes pedir acceso, rectificación, cancelación u oposición, y revocar este consentimiento, escribiendo a contacto@fsanchezt.dev. Si la respuesta no te basta, puedes acudir al INAI.",
            "You can request access, correction, deletion, or objection, and you can withdraw this consent, by writing to contacto@fsanchezt.dev. If the reply is not enough, you can go to Mexico's INAI.",
          )}
        </p>

        <h2 class="t-sub mt-10">{t("Cookies", "Cookies")}</h2>
        <p class="t-body mt-3">
          {t(
            "Este sitio no usa cookies de analítica ni de anuncios.",
            "This site does not use analytics or advertising cookies.",
          )}
        </p>

        <h2 class="t-sub mt-10">{t("Alcance", "Scope")}</h2>
        <p class="t-body mt-3">
          {t(
            "Cubre solo el formulario de este dominio. No cubre GitHub, LinkedIn ni el sitio de Formspree. Última actualización: 14 de octubre de 2026.",
            "It covers only the form on this domain. It does not cover GitHub, LinkedIn, or Formspree's own site. Last updated: 14 October 2026.",
          )}
        </p>
        <p class="mt-10">
          <a href={localePath(lang)} class="link text-[15px] font-semibold">
            {t("Volver al inicio", "Back to home")}
          </a>
        </p>
      </article>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
