---
import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Hero from "../sections/Hero.astro";
import Services from "../sections/Services.astro";
import Process from "../sections/Process.astro";
import Projects from "../sections/Projects.astro";
import Education from "../sections/Education.astro";
import Contact from "../sections/Contact.astro";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang}>
  <a href="#inicio" class="skip-link">{t("Saltar al contenido", "Skip to content")}</a>
  <Navbar lang={lang} />
  <main class="sheet layer">
    <Hero lang={lang} />
    <Projects lang={lang} />
    <Services lang={lang} />
    <Process lang={lang} />
    <Education lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>

<script>
  import { initAtelier } from "../scripts/atelier";

  initAtelier();
</script>
