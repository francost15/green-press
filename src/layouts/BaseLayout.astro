---
import SocialRail from "../components/SocialRail.astro";
import { personSchema, projectsSchema } from "../data/structuredData";
import { SITE, localePath, type Lang } from "../i18n";
import "../index.css";

interface Props {
  lang: Lang;
  /** Page title. Defaults to the site-level title for this locale. */
  title?: string;
  /** Meta description. Defaults to the site-level description for this locale. */
  description?: string;
  /** Path below the locale root, e.g. "projects/foo/". Empty for the home page. */
  path?: string;
  /** Same path in the other locale, for hreflang. Defaults to `path`. */
  altPath?: string;
  /** JSON-LD blocks. Defaults to the Person + project list used on the home page. */
  schemas?: unknown[];
}

const {
  lang,
  title: titleOverride,
  description: descriptionOverride,
  path = "",
  altPath,
  schemas = [personSchema, projectsSchema],
} = Astro.props;

const copy = {
  en: {
    title: "Franco Sanchez — AI & Software Engineer",
    description:
      "Franco Sanchez — AI Engineer and Software Architect. I turn technical complexity into profitability, cutting operational costs by up to 85%.",
    social:
      "Turning technical complexity into profitability, cutting operational costs by up to 85%.",
    ogLocale: "en_US",
    altLocale: "es_ES",
  },
  es: {
    title: "Franco Sanchez — Ingeniero de IA y Software",
    description:
      "Franco Sanchez — Ingeniero de IA y Arquitecto de Software. Transformo complejidad técnica en rentabilidad, reduciendo costos operativos hasta un 85%.",
    social:
      "Transformo complejidad técnica en rentabilidad, reduciendo costos operativos hasta un 85%.",
    ogLocale: "es_ES",
    altLocale: "en_US",
  },
}[lang];

const title = titleOverride ?? copy.title;
const description = descriptionOverride ?? copy.description;
const social = descriptionOverride ?? copy.social;

const enPath = lang === "en" ? path : (altPath ?? path);
const esPath = lang === "es" ? path : (altPath ?? path);

const canonical = `${SITE}${localePath(lang, path)}`;
const enHref = `${SITE}${localePath("en", enPath)}`;
const esHref = `${SITE}${localePath("es", esPath)}`;

const ogImage = `${SITE}/og-image.png`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="AI Engineer, Machine Learning, Full-Stack Architecture, React, Python, RAG, LangChain, CTO, Tech Lead"
    />
    <meta name="author" content="Franco Sanchez" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={social} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Franco Sanchez — AI & Software Engineer" />
    <meta property="og:locale" content={copy.ogLocale} />
    <meta property="og:locale:alternate" content={copy.altLocale} />
    <meta property="og:site_name" content="Franco Sanchez" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={social} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts — one self-hosted variable face, 38KB, no third-party origin. -->
    <link rel="preload" href="/fonts/general-sans-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Structured data — readable by AI crawlers without JavaScript -->
    {
      schemas.map((schema) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
      ))
    }

    {/* No theme-init script: this site has one appearance, so there is no
        stored preference to read and no flash of the wrong theme to prevent. */}
  </head>
  <body>
    <!--
      DIRECTION CONTRACT — user-pinned (chosen from three built previews)
      THESIS: Swiss editorial minimalism. The page is a ruled sheet: a visible
        twelve-column grid, marginal meta, and rows — never cards. Refuses the
        dark-canvas-plus-accent portfolio this site used to be, and decoration of
        every kind: the ornament is the grid itself.
      OWN-WORLD: White paper, ink #0A0A0B, mid #6B6B76, hairlines #E6E6EA, violet
        #6D28D9 as the working accent. General Sans variable at four sizes only. Type
        enters from behind a mask, line by line; scroll reveals are native view()
        timelines; buttons confirm the press at scale(0.97). User-pinned evolutions,
        2026-08-05, supersede the original once-per-viewport violet budget: a full-bleed
        aurora wash behind the first viewport, a 2px scroll-progress hairline, an ink
        capsule social rail, and two full-bleed colour fields pacing the sheet — ink
        (Competencies) and deep violet #5B21B6 (Contact). The drawn grid shares the
        layout grid's gap: they are the same grid or neither is worth drawing.
      STORY: A recruiter reads name, role and record above the fold, in either
        language, and takes the CV. A client reads the same rows and writes.
      FIRST VIEWPORT: Meta column left with role, base, languages, systems shipped.
        The name at display scale right — "Sanchez" carries the viewport's one violet —
        with the working claim beneath and the CV as the filled action.
      FORM: Editorial Rule, fused with the name-first masthead at the user's explicit
        direction after comparing three built previews. Roll set aside: user-pinned.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish
        review, the verdict, and DESIGN.md
    -->
    <div class="progress" aria-hidden="true"></div>
    <slot />
    {/* After the slot on purpose: the skip link inside it must stay the first
        focusable element on every route. */}
    <SocialRail lang={lang} />

  </body>
</html>
