---
import SocialRail from "../components/SocialRail.astro";
import { personSchema, profilePageSchema, projectsSchema, websiteSchema } from "../data/structuredData";
import { SITE, localePath, type Lang } from "../i18n";
import "../index.css";

interface Props {
  lang: Lang;
  /** Page title. Defaults to the site-level title for this locale. */
  title?: string;
  /** Meta description. Defaults to the site-level description for this locale. */
  description?: string;
  /** Path below the locale root, e.g. "projects/foo/". Empty for the home page. */
  path?: string;
  /** Same path in the other locale, for hreflang. Defaults to `path`. */
  altPath?: string;
  /** JSON-LD blocks. Defaults to the Person + project list used on the home page. */
  schemas?: unknown[];
}

const {
  lang,
  title: titleOverride,
  description: descriptionOverride,
  path = "",
  altPath,
  schemas = [websiteSchema(), profilePageSchema(lang), personSchema(lang), projectsSchema(lang)],
} = Astro.props;

const copy = {
  /* Description and social copy must only name outcomes a project page can source.
     These used to claim "cutting operational costs by up to 85%", a figure no
     project's `impact` field supports. Job title stays byte-identical to
     `profile.title` and to `personSchema.jobTitle` — three surfaces, one string. */
  en: {
    title: "Franco Sanchez - AI & Software Engineer",
    description:
      "Franco Sanchez, AI & Software Engineer in Puebla, Mexico. Five AI systems in production: a textile ERP, CFDI fiscal invoicing, a university RAG assistant, BI dashboards, and job matching.",
    social:
      "Five AI systems in production, not demos: textile ERP, CFDI invoicing, university RAG assistant.",
    ogLocale: "en_US",
    altLocale: "es_ES",
  },
  es: {
    title: "Franco Sanchez - Ingeniero de IA y Software",
    description:
      "Franco Sanchez diseña sistemas de IA y software que ya operan: ERP textil, facturación CFDI, un asistente RAG universitario, dashboards de BI y matching de talento. Puebla, México.",
    social:
      "Cinco sistemas de IA en producción, no demos: ERP textil, facturación CFDI, asistente RAG universitario.",
    ogLocale: "es_ES",
    altLocale: "en_US",
  },
}[lang];

const title = titleOverride ?? copy.title;
const description = descriptionOverride ?? copy.description;
const social = descriptionOverride ?? copy.social;

const enPath = lang === "en" ? path : (altPath ?? path);
const esPath = lang === "es" ? path : (altPath ?? path);

const canonical = `${SITE}${localePath(lang, path)}`;
const enHref = `${SITE}${localePath("en", enPath)}`;
const esHref = `${SITE}${localePath("es", esPath)}`;
const homeCollision = enHref === esHref;

const ogImage = `${SITE}/og-image.png`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8f8f6" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {/* No `keywords` meta: search engines ignore it, LLM extractors do read it, and it
        claimed CTO and Tech Lead — titles that appear nowhere else on this site. */}
    <meta name="author" content="Franco Sanchez" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    {
      homeCollision ? (
        <>
          <link rel="alternate" hreflang="es" href={esHref} />
          <link rel="alternate" hreflang="x-default" href={esHref} />
        </>
      ) : (
        <>
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="es" href={esHref} />
          <link rel="alternate" hreflang="x-default" href={esHref} />
        </>
      )
    }

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={social} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Franco Sanchez - AI & Software Engineer" />
    <meta property="og:locale" content={copy.ogLocale} />
    <meta property="og:locale:alternate" content={copy.altLocale} />
    <meta property="og:site_name" content="Franco Sanchez" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={social} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts — self-hosted only, no third-party origin. -->
    <link rel="preload" href="/fonts/general-sans-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Structured data — readable by AI crawlers without JavaScript -->
    {
      schemas.map((schema) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
      ))
    }

    {/* No theme-init script: this site has one appearance, so there is no
        stored preference to read and no flash of the wrong theme to prevent. */}
  </head>
  <body>
    <!--
      DIRECTION CONTRACT — Studio Showcase & Fanned Deck (2026-10-14)
      THESIS: Product studio showcase built to convert B2B clients through immediate
        visual proof, choreographed GSAP motion, and clear action paths.
      OWN-WORLD: Gallery canvas #F8F8F6, pure white concentric cards #FFFFFF, deep ink
        #0E0E11, electric blue #2546F0, and lime conversion signals #C8F904.
      STORY: A founder or CTO lands, sees the value proposition, interacts with the
        fanned 5-system deck and floating metric chips, explores the bento catalog,
        and initiates a project quote.
    -->
    <div class="progress" aria-hidden="true"></div>
    <slot />
    {/* After the slot on purpose: the skip link inside it must stay the first
        focusable element on every route. */}
    <SocialRail lang={lang} />

  </body>
</html>
