---
import { profile } from "../data/profile";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="acerca" class="band">
  <div class="in max-w-[76ch]">
    <h2 class="t-head">{profile.legalName}</h2>
    <p class="t-body mt-4 max-w-[65ch]">{t(profile.bio.es, profile.bio.en)}</p>
  </div>
</section>
