---
import { services } from "../data/services";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="servicios" class="band offer-band" data-offer="0">
  <div class="offer-head">
    <h2 class="t-head">{t("Servicios", "Services")}</h2>
    <p class="t-body">
      {
        t(
          "Asistentes, tableros y una primera versión de producto. Los tres ya están en producción.",
          "Assistants, dashboards, and a first product version. All three are already in production.",
        )
      }
    </p>
  </div>
  <ol class="offer-list">
    {
      services.map((service, idx) => (
        <li class={idx === 0 ? "is-lead" : undefined}>
          <span class="offer-n tabular">0{idx + 1}</span>
          <div>
            <h3>{t(service.title.es, service.title.en)}</h3>
            <p>{t(service.audience.es, service.audience.en)}</p>
            <p>{t(service.deliverable.es, service.deliverable.en)}</p>
            <p class="offer-proof">{t(service.proof.es, service.proof.en)}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <p class="offer-foot">
    <a href="#contacto">
      {t("Cotizar proyecto", "Start a project")}
      <span aria-hidden="true"> ↗</span>
    </a>
  </p>
</section>
