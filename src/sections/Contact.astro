---
import Section from "../components/Section.astro";
import Icon from "../components/Icon.astro";
import { profile } from "../data/profile";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contactLinks = [
  { icon: "LinkedinLogo", label: "LinkedIn", href: profile.links.linkedin, external: true },
  { icon: "GithubLogo", label: "GitHub", href: profile.links.github, external: true },
  { icon: "EnvelopeSimple", label: profile.email, href: `mailto:${profile.email}`, external: false },
  {
    icon: "Phone",
    label: profile.phone,
    href: `tel:${profile.phone.replace(/\s+/g, "")}`,
    external: false,
  },
];

/* Every message names the problem and the recovery, in the reader's language.
   They ship as data attributes so the validator stays a small, untranslated
   script and the copy stays with the rest of the copy. */
const messages = {
  nameRequired: t(
    "Escribe tu nombre para saber cómo dirigirme a ti.",
    "Enter your name so I know how to address you.",
  ),
  emailRequired: t(
    "Escribe tu correo, o no tendré cómo responderte.",
    "Enter your email, or I will have no way to reply.",
  ),
  emailInvalid: t(
    "Ese correo no parece completo. Revisa que lleve una arroba y un dominio.",
    "That email looks incomplete. Check that it has an @ and a domain.",
  ),
  messageRequired: t(
    "Cuéntame algo del proyecto, aunque sea una frase.",
    "Tell me something about the project, even one sentence.",
  ),
  sendFailed: t(
    "No se pudo enviar. Revisa tu conexión e inténtalo otra vez, o escríbeme directo a " +
      profile.email +
      ".",
    "It could not be sent. Check your connection and try again, or email me directly at " +
      profile.email +
      ".",
  ),
  sent: t(
    "Mensaje enviado. Te respondo pronto.",
    "Message sent. I will get back to you soon.",
  ),
};

const labels = {
  idle: t("Enviar mensaje", "Send message"),
  sending: t("Enviando…", "Sending…"),
  sent: t("Enviado", "Sent"),
};
---

<Section
  id="contacto"
  class="band-violet"
  title={t("Contacto", "Contact")}
  meta={t("4 canales", "4 channels")}
  subtitle={t(
    "¿Una vacante o un proyecto? Escríbeme. El CV está en el hero y también como enlace de texto aquí.",
    "An open role or a project? Write to me. The CV is in the hero, and as a text link here.",
  )}
>
  <div class="cols hair-t pt-10">
    <div class="c-meta">
      <a href={profile.cvUrl} download class="link mb-8 inline-flex min-h-[44px] items-center text-[15px] font-semibold">
        {t("Descargar CV", "Download CV")}
      </a>

      <p class="t-meta mb-3">{t("Encuéntrame en", "Find me on")}</p>
      <ul class="flex flex-col">
        {
          contactLinks.map(({ icon, label, href, external }) => (
            <li>
              <a
                href={href}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
                class="flex min-h-[44px] items-center gap-2.5 text-[15px] text-[var(--ink)] transition-colors duration-150 hover:text-[var(--violet)]"
              >
                <Icon name={icon} size={16} />
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <form
      data-contact-form
      data-endpoint={`https://formspree.io/f/${profile.formspreeId}`}
      class="c-main flex flex-col gap-6"
      novalidate
      data-msg-name={messages.nameRequired}
      data-msg-email={messages.emailRequired}
      data-msg-email-invalid={messages.emailInvalid}
      data-msg-message={messages.messageRequired}
      data-msg-failed={messages.sendFailed}
      data-msg-sent={messages.sent}
    >
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="contact-name" class="t-meta mb-2 block">
            {t("Nombre", "Name")} <span aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            id="contact-name"
            name="name"
            required
            autocomplete="name"
            class="field"
            aria-describedby="contact-name-error"
          />
          <p id="contact-name-error" class="field-error" hidden>
            <Icon name="X" size={15} />
            <span data-error-text></span>
          </p>
        </div>

        <div>
          <label for="contact-email" class="t-meta mb-2 block">
            Email <span aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            id="contact-email"
            name="email"
            required
            autocomplete="email"
            class="field"
            aria-describedby="contact-email-error"
          />
          <p id="contact-email-error" class="field-error" hidden>
            <Icon name="X" size={15} />
            <span data-error-text></span>
          </p>
        </div>
      </div>

      <div>
        <label for="contact-message" class="t-meta mb-2 block">
          {t("Mensaje", "Message")} <span aria-hidden="true">*</span>
        </label>
        <textarea
          id="contact-message"
          name="message"
          required
          rows="6"
          class="field resize-y"
          aria-describedby="contact-message-error"></textarea>
        <p id="contact-message-error" class="field-error" hidden>
          <Icon name="X" size={15} />
          <span data-error-text></span>
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <button
          type="submit"
          data-submit
          data-label-idle={labels.idle}
          data-label-sending={labels.sending}
          data-label-sent={labels.sent}
          class="act"
        >
          <span data-submit-label>{labels.idle}</span>
        </button>

        {/* One status region for the whole form, next to the control that
            triggers it — not a toast pinned to a corner of the viewport. */}
        <p data-form-status role="status" aria-live="polite" class="text-[15px] font-semibold"></p>
      </div>
      <p class="t-meta mt-6 max-w-[48ch]">
        {t(
          "Al enviar, aceptas el aviso de privacidad. El mensaje viaja a Formspree y me llega al correo de contacto.",
          "By sending, you accept the privacy notice. The message goes through Formspree and reaches my contact mailbox.",
        )}{" "}
        <a href={lang === "es" ? "/es/privacidad/" : "/privacy/"} class="link">
          {t("Aviso de privacidad", "Privacy notice")}
        </a>
        .
      </p>
    </form>
  </div>
</Section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const button = form.querySelector<HTMLButtonElement>("[data-submit]");
    const buttonLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const copy = form.dataset;

    const fieldOf = (id: string) => document.getElementById(id) as HTMLInputElement | null;

    const setFieldError = (input: HTMLInputElement | HTMLTextAreaElement, message: string | null) => {
      const box = document.getElementById(`${input.id}-error`);
      const text = box?.querySelector<HTMLElement>("[data-error-text]");
      if (message) {
        input.setAttribute("aria-invalid", "true");
        if (box) box.hidden = false;
        if (text) text.textContent = message;
      } else {
        input.removeAttribute("aria-invalid");
        if (box) box.hidden = true;
        if (text) text.textContent = "";
      }
    };

    const validate = () => {
      const name = fieldOf("contact-name");
      const email = fieldOf("contact-email");
      const message = document.getElementById("contact-message") as HTMLTextAreaElement | null;
      const invalid: (HTMLInputElement | HTMLTextAreaElement)[] = [];

      if (name) {
        const bad = !name.value.trim();
        setFieldError(name, bad ? (copy.msgName ?? "") : null);
        if (bad) invalid.push(name);
      }

      if (email) {
        const value = email.value.trim();
        // Deliberately loose: something, an @, something, a dot, something.
        const looksLikeEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
        const msg = !value ? copy.msgEmail : !looksLikeEmail ? copy.msgEmailInvalid : null;
        setFieldError(email, msg ?? null);
        if (msg) invalid.push(email);
      }

      if (message) {
        const bad = !message.value.trim();
        setFieldError(message, bad ? (copy.msgMessage ?? "") : null);
        if (bad) invalid.push(message);
      }

      return invalid;
    };

    // Once a field has been marked, re-check it as the reader fixes it, so the
    // error clears the moment it stops being true.
    for (const el of form.querySelectorAll<HTMLInputElement>("input, textarea")) {
      el.addEventListener("input", () => {
        if (el.hasAttribute("aria-invalid")) validate();
      });
    }

    const setBusy = (state: "idle" | "sending" | "sent") => {
      if (!button || !buttonLabel) return;
      button.disabled = state !== "idle";
      const label =
        state === "sending"
          ? button.dataset.labelSending
          : state === "sent"
            ? button.dataset.labelSent
            : button.dataset.labelIdle;
      if (label) buttonLabel.textContent = label;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const invalid = validate();
      if (invalid.length > 0) {
        // Errors are announced assertively and the first one takes focus, so a
        // screen-reader user is not left guessing why nothing happened.
        if (status) {
          status.setAttribute("aria-live", "assertive");
          status.textContent = "";
        }
        invalid[0].focus();
        return;
      }

      if (status) {
        status.setAttribute("aria-live", "polite");
        status.textContent = "";
      }
      setBusy("sending");

      try {
        const response = await fetch(form.dataset.endpoint ?? "", {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(`Request failed: ${response.status}`);

        setBusy("sent");
        if (status) status.textContent = copy.msgSent ?? "";
        form.reset();
        setTimeout(() => {
          setBusy("idle");
          if (status) status.textContent = "";
        }, 6000);
      } catch {
        setBusy("idle");
        if (status) {
          status.setAttribute("aria-live", "assertive");
          status.textContent = copy.msgFailed ?? "";
        }
      }
    });
  }
</script>
