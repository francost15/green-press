---
import Section from "../components/Section.astro";
import Icon from "../components/Icon.astro";
import { profile } from "../data/profile";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contactLinks = [
  { icon: "LinkedinLogo", label: "LinkedIn", href: profile.links.linkedin, external: true },
  { icon: "GithubLogo", label: "GitHub", href: profile.links.github, external: true },
  { icon: "EnvelopeSimple", label: profile.email, href: `mailto:${profile.email}`, external: false },
  {
    icon: "Phone",
    label: profile.phone,
    href: `tel:${profile.phone.replace(/\s+/g, "")}`,
    external: false,
  },
];

/* Every message names the problem and the recovery, in the reader's language.
   They ship as data attributes so the validator stays a small, untranslated
   script and the copy stays with the rest of the copy. */
const messages = {
  nameRequired: t(
    "Escribe tu nombre para saber cómo dirigirme a ti.",
    "Enter your name so I know how to address you.",
  ),
  emailRequired: t(
    "Escribe tu correo, o no tendré cómo responderte.",
    "Enter your email, or I will have no way to reply.",
  ),
  emailInvalid: t(
    "Ese correo no parece completo. Revisa que lleve una arroba y un dominio válido.",
    "That email looks incomplete. Check that it has an @ and a valid domain.",
  ),
  messageRequired: t(
    "Cuéntame algo del proyecto, aunque sea una frase.",
    "Tell me something about the project, even one sentence.",
  ),
  rateLimited: t(
    "Acabas de enviar un mensaje. Espera un minuto antes de enviar otro.",
    "You just sent a message. Please wait a minute before sending another.",
  ),
  sendFailed: t(
    "No se pudo enviar. Revisa tu conexión e inténtalo otra vez, o escríbeme directo a " +
      profile.email +
      ".",
    "It could not be sent. Check your connection and try again, or email me directly at " +
      profile.email +
      ".",
  ),
  sent: t(
    "Mensaje enviado. Te respondo pronto.",
    "Message sent. I will get back to you soon.",
  ),
};

const labels = {
  idle: t("Enviar mensaje", "Send message"),
  sending: t("Enviando…", "Sending…"),
  sent: t("Enviado", "Sent"),
};
---

<Section
  id="contacto"
  class="band-violet"
  title={t("Iniciemos tu proyecto", "Let's start your project")}
  subtitle={t(
    "¿Buscas automatizar un flujo operativo, lanzar un agente de IA o construir software a medida? Cuéntame el objetivo y te respondo con una propuesta clara.",
    "Looking to automate an operational workflow, launch an AI agent, or build custom software? Share your goal and I will reply with a clear roadmap.",
  )}
>
  <div class="cols hair-t pt-10">
    <div class="c-meta">
      <div class="contact-channels-box">
        <span class="edu-status-lime">
          {t("Canales directos", "Direct channels")}
        </span>
        <ul class="m-0 mt-4 flex flex-col list-none p-0">
          {
            contactLinks.map(({ icon, label, href, external }) => (
              <li>
                <a
                  href={href}
                  target={external ? "_blank" : undefined}
                  rel={external ? "noopener noreferrer" : undefined}
                  class="contact-channel-link flex min-h-[44px] items-center gap-2.5 text-[15px] font-medium"
                >
                  <Icon name={icon} size={17} />
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="c-main">
      <form
        data-contact-form
        data-endpoint={`https://formspree.io/f/${profile.formspreeId}`}
        class="flex flex-col gap-6"
        novalidate
        data-msg-name={messages.nameRequired}
        data-msg-email={messages.emailRequired}
        data-msg-email-invalid={messages.emailInvalid}
        data-msg-message={messages.messageRequired}
        data-msg-rate-limit={messages.rateLimited}
        data-msg-failed={messages.sendFailed}
        data-msg-sent={messages.sent}
      >
        {/* Honeypot anti-bot trap: off-screen, no text node to pollute copy/paste */}
        <div class="hp-trap" aria-hidden="true">
          <input
            type="text"
            id="contact-company-website"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
            aria-label="Website"
          />
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="contact-name" class="t-meta mb-2 block">
              {t("Nombre", "Name")} <span aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              maxlength="120"
              autocomplete="name"
              class="field"
              aria-describedby="contact-name-error"
            />
            <p id="contact-name-error" class="field-error" hidden>
              <Icon name="X" size={15} />
              <span data-error-text></span>
            </p>
          </div>

          <div>
            <label for="contact-email" class="t-meta mb-2 block">
              Email <span aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              maxlength="254"
              autocomplete="email"
              class="field"
              aria-describedby="contact-email-error"
            />
            <p id="contact-email-error" class="field-error" hidden>
              <Icon name="X" size={15} />
              <span data-error-text></span>
            </p>
          </div>
        </div>

        <div>
          <label for="contact-message" class="t-meta mb-2 block">
            {t("Mensaje", "Message")} <span aria-hidden="true">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            required
            maxlength="4000"
            rows="5"
            class="field resize-y"
            aria-describedby="contact-message-error"></textarea>
          <p id="contact-message-error" class="field-error" hidden>
            <Icon name="X" size={15} />
            <span data-error-text></span>
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <button
            type="submit"
            data-submit
            data-label-idle={labels.idle}
            data-label-sending={labels.sending}
            data-label-sent={labels.sent}
            class="act"
          >
            <span data-submit-label>{labels.idle}</span>
            <span class="act-badge" aria-hidden="true">↗</span>
          </button>

          <p data-form-status role="status" aria-live="polite" class="text-[15px] font-semibold"></p>
        </div>

        <p class="t-meta mt-2 max-w-[54ch]">
          {t(
            "Al enviar, aceptas el aviso de privacidad. El mensaje viaja cifrado por HTTPS a Formspree y llega directo a mi buzón.",
            "By sending, you accept the privacy notice. Your message is sent over HTTPS via Formspree directly to my mailbox.",
          )}{" "}
          <a href={lang === "es" ? "/es/privacidad/" : "/privacy/"} class="link">
            {t("Aviso de privacidad", "Privacy notice")}
          </a>
          .
        </p>
      </form>
    </div>
  </div>
</Section>

<script>
  const COOLDOWN_KEY = "fs_contact_cooldown_ts";
  const COOLDOWN_MS = 60_000;
  const FETCH_TIMEOUT_MS = 10_000;

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const button = form.querySelector<HTMLButtonElement>("[data-submit]");
    const buttonLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const honeypot = form.querySelector<HTMLInputElement>('input[name="_gotcha"]');
    const copy = form.dataset;

    const sanitizeText = (raw: string, maxLen: number): string =>
      raw.replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/g, "").trim().slice(0, maxLen);

    const fieldOf = (id: string) => document.getElementById(id) as HTMLInputElement | null;

    const setFieldError = (input: HTMLInputElement | HTMLTextAreaElement, message: string | null) => {
      const box = document.getElementById(`${input.id}-error`);
      const text = box?.querySelector<HTMLElement>("[data-error-text]");
      if (message) {
        input.setAttribute("aria-invalid", "true");
        if (box) box.hidden = false;
        if (text) text.textContent = message;
      } else {
        input.removeAttribute("aria-invalid");
        if (box) box.hidden = true;
        if (text) text.textContent = "";
      }
    };

    const validate = () => {
      const name = fieldOf("contact-name");
      const email = fieldOf("contact-email");
      const message = document.getElementById("contact-message") as HTMLTextAreaElement | null;
      const invalid: (HTMLInputElement | HTMLTextAreaElement)[] = [];

      if (name) {
        const clean = sanitizeText(name.value, 120);
        const bad = !clean;
        setFieldError(name, bad ? (copy.msgName ?? "") : null);
        if (bad) invalid.push(name);
      }

      if (email) {
        const value = sanitizeText(email.value, 254);
        const looksLikeEmail =
          value.length <= 254 &&
          /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)+$/.test(value);
        const msg = !value ? copy.msgEmail : !looksLikeEmail ? copy.msgEmailInvalid : null;
        setFieldError(email, msg ?? null);
        if (msg) invalid.push(email);
      }

      if (message) {
        const clean = sanitizeText(message.value, 4000);
        const bad = !clean;
        setFieldError(message, bad ? (copy.msgMessage ?? "") : null);
        if (bad) invalid.push(message);
      }

      return invalid;
    };

    for (const el of form.querySelectorAll<HTMLInputElement>("input, textarea")) {
      el.addEventListener("input", () => {
        if (el.hasAttribute("aria-invalid")) validate();
      });
    }

    const setBusy = (state: "idle" | "sending" | "sent") => {
      if (!button || !buttonLabel) return;
      button.disabled = state !== "idle";
      const label =
        state === "sending"
          ? button.dataset.labelSending
          : state === "sent"
            ? button.dataset.labelSent
            : button.dataset.labelIdle;
      if (label) buttonLabel.textContent = label;
    };

    const isCooldownActive = (): boolean => {
      try {
        const last = Number(sessionStorage.getItem(COOLDOWN_KEY) ?? "0");
        return last > 0 && Date.now() - last < COOLDOWN_MS;
      } catch {
        return false;
      }
    };

    const markSentCooldown = () => {
      try {
        sessionStorage.setItem(COOLDOWN_KEY, String(Date.now()));
      } catch {
        // Ignore storage errors in private browsing
      }
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Silent drop if honeypot is filled by a bot
      if (honeypot && honeypot.value.trim().length > 0) {
        setBusy("sent");
        if (status) status.textContent = copy.msgSent ?? "";
        form.reset();
        return;
      }

      const invalid = validate();
      if (invalid.length > 0) {
        if (status) {
          status.setAttribute("aria-live", "assertive");
          status.textContent = "";
        }
        invalid[0].focus();
        return;
      }

      if (isCooldownActive()) {
        if (status) {
          status.setAttribute("aria-live", "assertive");
          status.textContent = copy.msgRateLimit ?? "";
        }
        return;
      }

      if (status) {
        status.setAttribute("aria-live", "polite");
        status.textContent = "";
      }
      setBusy("sending");

      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), FETCH_TIMEOUT_MS);

      try {
        const payload = new FormData(form);
        const nameInput = fieldOf("contact-name");
        const emailInput = fieldOf("contact-email");
        const messageInput = document.getElementById("contact-message") as HTMLTextAreaElement | null;
        if (nameInput) payload.set("name", sanitizeText(nameInput.value, 120));
        if (emailInput) payload.set("email", sanitizeText(emailInput.value, 254));
        if (messageInput) payload.set("message", sanitizeText(messageInput.value, 4000));

        const response = await fetch(form.dataset.endpoint ?? "", {
          method: "POST",
          body: payload,
          headers: { Accept: "application/json" },
          mode: "cors",
          credentials: "omit",
          referrerPolicy: "strict-origin-when-cross-origin",
          signal: controller.signal,
        });
        window.clearTimeout(timer);
        if (!response.ok) throw new Error(`Request failed: ${response.status}`);

        markSentCooldown();
        setBusy("sent");
        if (status) status.textContent = copy.msgSent ?? "";
        form.reset();
        setTimeout(() => {
          setBusy("idle");
          if (status) status.textContent = "";
        }, 6000);
      } catch {
        window.clearTimeout(timer);
        setBusy("idle");
        if (status) {
          status.setAttribute("aria-live", "assertive");
          status.textContent = copy.msgFailed ?? "";
        }
      }
    });
  }
</script>
