---
import Section from "../components/Section.astro";
import { projects } from "../data/projects";
import { localePath, useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Each project has its own route. The detail used to live in a hidden modal on this page,
// which put ~70% of the page's words inside a [hidden] subtree — the exact thing AI
// extraction pipelines discard before indexing.
const indexSegment = lang === "es" ? "proyectos/" : "projects/";
---

<Section
  id="proyectos"
  title={t("¿Qué sistemas pagué con trabajo real?", "What systems did someone pay to keep running?")}
  meta={t(`${projects.length} entradas`, `${projects.length} entries`)}
  subtitle={t(
    "Cinco sistemas en producción: ERP y dashboard en Towel, CFDI en Idea15, RAG en la UVP, matching de CVs para LTC. Cada página nombra cliente, fechas y cómo se midió el impacto. No son demos.",
    "Five systems in production: ERP and dashboard at Towel, CFDI at Idea15, RAG at UVP, CV matching for LTC. Each page names the client, the dates, and how impact was measured. Not demos.",
  )}
>
  <ul class="m-0 list-none p-0">
    {
      projects.map((project, i) => {
        const href = localePath(lang, `${indexSegment}${project.slug}/`);
        const tags = lang === "es" ? project.tags.es : project.tags.en;
        return (
          <li class="row">
            <div class="row-n">
              <p class="t-meta">{String(i + 1).padStart(2, "0")}</p>
            </div>
            <div class="row-t">
              <h3 class="t-sub">
                {/* Stretched link: the whole row is clickable, but only the title is a
                    link in the accessibility tree, so screen readers get one target. */}
                <a href={href} class="row-link">
                  {t(project.title.es, project.title.en)}
                </a>
              </h3>
              <ul class="tags mt-3">
                {tags.slice(0, 5).map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
            <div class="row-d">
              <p class="t-meta">{t("Impacto", "Impact")}</p>
            <p class="t-body mt-1 text-[0.95rem]" data-speakable-impact>
              {t(project.impact.es, project.impact.en)}
            </p>
            </div>
            <span class="row-mark" aria-hidden="true" />
          </li>
        );
      })
    }
  </ul>
</Section>
