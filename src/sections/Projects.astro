---
import Section from "../components/Section.astro";
import Icon from "../components/Icon.astro";
import TechIcon from "../components/TechIcon.astro";
import { projects } from "../data/projects";
import { localePath, useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Each project has its own route. The detail used to live in a hidden modal on this page,
// which put ~70% of the page's words inside a [hidden] subtree — the exact thing AI
// extraction pipelines discard before indexing.
const indexSegment = lang === "es" ? "proyectos/" : "projects/";
---

<Section
  id="proyectos"
  number="02"
  title={t("Proyectos", "Projects")}
  subtitle={t("Soluciones reales con impacto medible", "Real solutions with measurable impact")}
>
  <div class="grid gap-5 sm:grid-cols-2" data-reveal-group>
    {
      projects.map((project, index) => {
        const href = localePath(lang, `${indexSegment}${project.slug}/`);
        const tags = lang === "es" ? project.tags.es : project.tags.en;
        return (
          <article class="stagger-item card group relative flex flex-col overflow-hidden">
            <div
              class="h-1 w-full flex-shrink-0"
              style="background: linear-gradient(90deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 25%, transparent))"
            />

            <div
              class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-400 group-hover:opacity-100"
              aria-hidden="true"
              style="background: radial-gradient(ellipse 80% 40% at 50% 0%, color-mix(in srgb, var(--color-accent) 6%, transparent), transparent)"
            />

            <div class="flex flex-1 flex-col p-7">
              <div class="mb-5 flex items-start justify-between">
                <span class="section-label">Project {String(index + 1).padStart(2, "0")}</span>
                <div class="relative z-10 flex items-center gap-3">
                  {project.github && (
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex h-10 w-10 items-center justify-center rounded-lg text-text-tertiary transition-[color,background-color] hover:bg-bg-secondary hover:text-text-primary"
                      aria-label={`GitHub — ${project.title}`}
                    >
                      <Icon name="GithubLogo" size={17} />
                    </a>
                  )}
                  {project.link && (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex h-10 w-10 items-center justify-center rounded-lg text-text-tertiary transition-[color,background-color] hover:bg-bg-secondary hover:text-text-primary"
                      aria-label={`Live demo — ${project.title}`}
                    >
                      <Icon name="ArrowSquareOut" size={17} />
                    </a>
                  )}
                </div>
              </div>

              <h3 class="mb-5 font-[family-name:var(--color-font-display)] text-2xl font-black leading-tight tracking-tight text-text-primary">
                {/* Stretched link: the whole card is clickable, but only the title is a link
                    in the accessibility tree, so screen readers get one clear target. */}
                <a href={href} class="card-link">
                  {project.title}
                </a>
              </h3>

              <div class="mb-6 rounded-xl border border-accent/20 bg-accent/5 px-4 py-3">
                <p class="mb-1 section-label">{t("Impacto", "Impact")}</p>
                <p class="text-sm font-semibold leading-snug text-text-primary">
                  {t(project.impact.es, project.impact.en)}
                </p>
              </div>

              <div class="mb-6 flex flex-1 flex-wrap gap-1.5">
                {tags.slice(0, 5).map((tag) => (
                  <span class="tech-pill">
                    <TechIcon name={tag} variant="mono" class="h-3 w-3 opacity-60" />
                    {tag}
                  </span>
                ))}
              </div>

              <span class="preview-button inline-flex items-center gap-2 self-start rounded-full border border-border bg-bg-secondary px-4 py-2 text-xs font-semibold text-text-secondary group-hover:border-accent group-hover:text-accent">
                <Icon name="Eye" size={15} />
                {t("Ver proyecto", "View project")}
              </span>
            </div>
          </article>
        );
      })
    }
  </div>
</Section>

<style>
  .preview-button {
    transition:
      border-color 150ms ease,
      color 150ms ease;
  }

  /* Stretch the title link over the whole card without nesting interactive elements. */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
</style>
