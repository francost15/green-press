---
import Section from "../components/Section.astro";
import { projects } from "../data/projects";
import { imageSizes, smallVariant } from "../data/imageSizes";
import { localePath, useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const indexSegment = lang === "es" ? "proyectos/" : "projects/";

const kpis = [
  { num: "−90%", label: { es: "tiempo de reporte semanal", en: "weekly report time" } },
  { num: "80%", label: { es: "del flujo contable automatizado", en: "of the accounting flow automated" } },
  { num: "65%", label: { es: "de consultas resueltas solas", en: "of tier-1 queries resolved" } },
  { num: "+40%", label: { es: "de visibilidad en planta", en: "plant-floor visibility" } },
  { num: "−75%", label: { es: "en el filtrado inicial", en: "initial screening time" } },
] as const;
---

<Section
  id="proyectos"
  title={t("Trabajo en producción", "Work in production")}
  subtitle={t(
    "Cinco sistemas que alguien paga por seguir usando. Abre cualquiera para ver arquitectura, cliente y cómo se midió el retorno.",
    "Five systems someone still pays to keep running. Open any of them for the architecture, the client, and how the return was measured.",
  )}
>
  <ul class="case-index m-0 list-none p-0" data-project-index>
    {
      projects.map((project, i) => {
        const href = localePath(lang, `${indexSegment}${project.slug}/`);
        const tags = lang === "es" ? project.tags.es : project.tags.en;
        const cover = project.images?.[0];
        const dims = cover ? imageSizes[cover] : undefined;
        const alt =
          (lang === "es" ? project.imageAlts?.es[0] : project.imageAlts?.en[0]) ??
          t(project.title.es, project.title.en);
        const kpi = kpis[i] ?? kpis[0];
        const featured = i === 0;

        return (
          <li class={featured ? "case-feature" : "case-tile"} data-panel>
            <a href={href} class="case-link">
              <div class="case-media">
                {cover ? (
                  <img
                    src={cover}
                    srcset={`${smallVariant(cover)} 768w, ${cover} 1536w`}
                    sizes={featured ? "(min-width: 900px) 58vw, 100vw" : "(min-width: 900px) 28vw, 100vw"}
                    alt={alt}
                    width={dims?.width ?? 768}
                    height={dims?.height ?? 386}
                    loading={i < 2 ? "eager" : "lazy"}
                    decoding="async"
                  />
                ) : (
                  <div class="case-blueprint">
                    <span>ERP · PostgreSQL</span>
                    <strong>
                      {t("8 estaciones en piso, en vivo", "8 shop-floor stations, live")}
                    </strong>
                  </div>
                )}
              </div>
              <div class="case-copy">
                <div class="case-meta">
                  <span class="tabular">{String(i + 1).padStart(2, "0")}</span>
                  <span>{t(project.client.es, project.client.en)}</span>
                  <span class="case-go" aria-hidden="true">↗</span>
                </div>
                <p class="case-kpi">
                  <strong class="tabular" data-case-figure>{kpi.num}</strong>
                  <span>{t(kpi.label.es, kpi.label.en)}</span>
                </p>
                <h3>{t(project.title.es, project.title.en)}</h3>
                <p class="case-impact" data-speakable-impact>
                  {t(project.impact.es, project.impact.en)}
                </p>
                <p class="case-tags">{tags.slice(0, 4).join(" · ")}</p>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>
</Section>
