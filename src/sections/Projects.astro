---
import Section from "../components/Section.astro";
import { projects } from "../data/projects";
import { smallVariant } from "../data/imageSizes";
import { localePath, useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const indexSegment = lang === "es" ? "proyectos/" : "projects/";

const clay = ["panel-navy", "panel-marker", "panel-violet", "panel-orange", "panel-blue"] as const;
---

<Section
  id="proyectos"
  title={t("¿Qué sistemas pagué con trabajo real?", "What systems did someone pay to keep running?")}
  meta={t(`${projects.length} entradas`, `${projects.length} entries`)}
  subtitle={t(
    "Cinco sistemas en producción: ERP y dashboard en Towel, CFDI en Idea15, RAG en la UVP, matching de CVs para LTC. Cada página nombra cliente, fechas y cómo se midió el impacto. No son demos.",
    "Five systems in production: ERP and dashboard at Towel, CFDI at Idea15, RAG at UVP, CV matching for LTC. Each page names the client, the dates, and how impact was measured. Not demos.",
  )}
>
  <ul class="project-panels m-0 list-none p-0" data-project-index>
    {
      projects.map((project, i) => {
        const href = localePath(lang, `${indexSegment}${project.slug}/`);
        const tags = lang === "es" ? project.tags.es : project.tags.en;
        const cover = project.images?.[0];
        const alt = (lang === "es" ? project.imageAlts?.es[0] : project.imageAlts?.en[0]) ??
          t(project.title.es, project.title.en);
        return (
          <li class={`panel ${clay[i] ?? "panel-navy"}${i === 0 ? " is-open" : ""}`} data-panel>
            <a href={href} class="row-link">
              <span class="panel-tab">{String(i + 1).padStart(2, "0")}</span>
              {
                cover ? (
                  <img
                    src={cover}
                    srcset={`${smallVariant(cover)} 768w, ${cover} 1536w`}
                    sizes="(min-width: 900px) 28vw, 100vw"
                    alt={alt}
                    width="768"
                    height="386"
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                ) : (
                  <span class="panel-void" aria-hidden="true"></span>
                )
              }
              <div class="panel-copy">
                <h3 class="t-sub">{t(project.title.es, project.title.en)}</h3>
                <ul class="tags mt-3">
                  {tags.slice(0, 5).map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                <p class="t-meta mt-4">{t("Impacto", "Impact")}</p>
                <p class="mt-1 text-[0.95rem]" data-speakable-impact>
                  {t(project.impact.es, project.impact.en)}
                </p>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>
</Section>

