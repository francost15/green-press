---
import { projects } from "../data/projects";
import { imageSizes, smallVariant } from "../data/imageSizes";
import { profile } from "../data/profile";
import { localePath, useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const indexSegment = lang === "es" ? "proyectos/" : "projects/";
const waText = t(
  "Hola Franco, quiero automatizar un proceso de mi negocio.",
  "Hi Franco, I want to automate a process in my business.",
);
const waHref = `https://wa.me/${profile.phone.replace(/\D/g, "")}?text=${encodeURIComponent(waText)}`;

const cardAccents = [
  "fan-card-accent-blue",
  "fan-card-accent-lime",
  "fan-card-accent-violet",
  "fan-card-accent-dark",
  "fan-card-accent-amber",
] as const;

let shotCount = 0;
---

<section id="inicio" class="band hero-work">
  <div class="hero-stage">
    {/* Wide 2-line Display Proposition with Ruang Edit Lime Arrow Pill */}
    <div class="hero-headline-wrap">
      <h1 class="hero-display-headline">
        <span class="hero-static mask d1">
          <span data-hero-line>{t("Automatizo la operación", "I automate the operation")}</span>
        </span>
        <span class="hero-static mask d2">
          <span data-hero-line>
            {t("de tu negocio con IA, en semanas.", "of your business with AI, in weeks.")}
          </span>
        </span>
      </h1>
    </div>

    <p class="hero-subcopy mask d2">
      <span data-hero-line>
        {
          t(
            "Asistentes que responden con la información de tu empresa, tableros que dejan de armarse a mano y una primera versión de producto lista para enseñar. Para PyMEs y startups.",
            "Assistants that answer with your company's own information, dashboards that stop being assembled by hand, and a first product version ready to show. For small businesses and startups.",
          )
        }
      </span>
    </p>

    {/* Clean 2-Button Sales CTA Row */}
    <div class="hero-cta-row" data-hero-line>
      <a href={waHref} class="act" target="_blank" rel="noopener noreferrer">
        <span>{t("Escríbeme por WhatsApp", "Message me on WhatsApp")}</span>
        <span class="act-badge" aria-hidden="true">↗</span>
      </a>
      <a href="#proyectos" class="act act-ghost">
        {t("Ver casos", "See the work")}
      </a>
    </div>
    <p class="hero-proof">
      {
        t(
          "5 sistemas en producción · −90% en el reporte semanal · 80% de un flujo contable automatizado",
          "5 systems in production · −90% on the weekly report · 80% of an accounting flow automated",
        )
      }
    </p>

    {/* Fanned Project Deck + Mindly Floating Glass Chips & Pallet Ross Cursor Tags */}
    <div class="fan-arena">
      <div class="fan-deck" data-fan-deck>
        {
          projects.map((project, index) => {
            const src = project.images?.[0];
            const dims = src ? imageSizes[src] : undefined;
            const alt =
              (lang === "es" ? project.imageAlts?.es[0] : project.imageAlts?.en[0]) ??
              t(project.title.es, project.title.en);
            const href = localePath(lang, `${indexSegment}${project.slug}/`);
            const isPrimaryWorkShot = Boolean(src && shotCount < 3);
            if (isPrimaryWorkShot) shotCount += 1;

            return (
              <a
                href={href}
                class={`fan-card ${cardAccents[index] ?? "fan-card-accent-blue"}`}
                data-fan-card
                data-work-shot={isPrimaryWorkShot ? "" : undefined}
              >
                <div class="fan-card-media">
                  {src ? (
                    <img
                      src={src}
                      srcset={`${smallVariant(src)} 768w, ${src} 1536w`}
                      sizes="(min-width: 960px) 540px, (min-width: 640px) 50vw, 94vw"
                      alt={alt}
                      width={dims?.width ?? 768}
                      height={dims?.height ?? 386}
                      loading={index === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  ) : (
                    <div class="fan-card-blueprint" aria-hidden="true">
                      <span class="tabular font-bold uppercase tracking-wider opacity-75">
                        ERP · SQL · Planta
                      </span>
                      <span class="text-[13px] font-semibold">
                        {t("8 estaciones conectadas en tiempo real", "8 plant stations connected live")}
                      </span>
                    </div>
                  )}
                </div>

                <div class="fan-card-body">
                  <p class="fan-card-title">{t(project.title.es, project.title.en)}</p>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initHero } from "../scripts/hero";

  initHero();
</script>
