---
import { profile } from "../data/profile";
import { projects } from "../data/projects";
import { experience } from "../data/experience";
import { smallVariant } from "../data/imageSizes";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const shipped = projects.length;
const engineeringSince = experience[experience.length - 1].period.start.slice(0, 4);
const current = experience[0];

const annotations = [
  { label: t("Perfil", "Role"), value: t(profile.title.es, profile.title.en) },
  { label: t("Base", "Based in"), value: t(profile.location.es, profile.location.en) },
  {
    label: t("En producción", "In production"),
    value: t(`${shipped} sistemas`, `${shipped} systems`),
  },
  {
    label: t("Ingeniería desde", "Engineering since"),
    value: engineeringSince,
  },
];

const polaroids = [
  {
    src: "/projects/ai-dashboard-1.webp",
    alt: t(
      "Dashboard de inteligencia de negocio en Towel",
      "Business intelligence dashboard at Towel",
    ),
    caption: "Towel",
  },
  {
    src: "/projects/cfdi-1.webp",
    alt: t("Formulario de emisión CFDI en Idea15", "CFDI issuance form at Idea15"),
    caption: "Idea15",
  },
  {
    src: "/projects/rag-chatbot-1.webp",
    alt: t("Asistente RAG de la UVP", "UVP RAG assistant"),
    caption: "UVP",
  },
];
---

<section id="inicio" class="band">
  <div class="cols">
    <dl class="c-meta order-2 m-0 flex flex-col gap-4 min-[900px]:order-1 min-[900px]:pt-2">
      {
        annotations.map((a) => (
          <div>
            <dt class="t-meta">{a.label}</dt>
            <dd class="mask m-0 mt-1 text-[15px] font-medium">
              <span data-hero-fact>{a.value}</span>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="c-main order-1 min-[900px]:order-2">
      <div class="mb-4 flex flex-wrap gap-2" aria-hidden="true">
        <span class="anno anno-marker" data-anno>{t(profile.title.es, profile.title.en)}</span>
        <span class="anno anno-blue" data-anno>{t(profile.location.es, profile.location.en)}</span>
        <span class="anno anno-clay" data-anno>{current.company}</span>
        <span class="anno anno-violet" data-anno>
          {t(`${shipped} sistemas en producción`, `${shipped} systems in production`)}
        </span>
      </div>

      <h1 class="t-display">
        <span class="name-box">
          <svg class="name-box-stroke" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <rect data-name-box x="1.5" y="1.5" width="97" height="97" pathLength="100"></rect>
          </svg>
          <span class="mask d1"><span data-hero-name>Franco</span></span>{" "}
          <span class="mask d2"><span class="accent" data-hero-name>Sanchez</span></span>
        </span>
      </h1>
      <p class="t-meta mask d3 mt-3">
        <span data-hero-line>{profile.legalName}</span>
      </p>

      <p class="t-sub mask d4 mt-6 max-w-[36ch]">
        <span data-hero-line>
          {
            t(
              "Cinco sistemas de IA en producción: planta, CFDI, universidad, reclutamiento.",
              "Five AI systems in production: plant floor, CFDI, university, recruitment.",
            )
          }
        </span>
      </p>

      <div class="mask d5 mt-8">
        <span class="flex flex-wrap items-center gap-3" data-hero-line>
          <a href={profile.cvUrl} download class="act">
            {t("Descargar CV", "Download CV")}
          </a>
          <a href="#proyectos" class="act act-ghost">
            {t("Ver el registro", "See the record")}
          </a>
        </span>
      </div>
    </div>
  </div>

  <div class="polaroid-row">
    {
      polaroids.map((shot) => (
        <figure class="polaroid" data-polaroid>
          <span class="tape" aria-hidden="true"></span>
          <img
            src={shot.src}
            srcset={`${smallVariant(shot.src)} 768w, ${shot.src} 1536w`}
            sizes="220px"
            alt={shot.alt}
            width="768"
            height="386"
            loading="eager"
            decoding="async"
          />
          <figcaption>{shot.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<script>
  import { initHero } from "../scripts/hero";

  initHero();
</script>
