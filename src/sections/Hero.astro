---
import { profile } from "../data/profile";
import { projects } from "../data/projects";
import { experience } from "../data/experience";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/* Counted from the record rather than typed, so the margin can never claim a
   number the data does not support. */
const shipped = projects.length;
const since = experience[experience.length - 1].period.start.slice(0, 4);

const annotations = [
  { label: t("Perfil", "Role"), value: t(profile.title.es, profile.title.en) },
  { label: t("Base", "Based in"), value: profile.location },
  { label: t("Idiomas", "Languages"), value: "Español · English" },
  {
    label: t("En producción", "In production"),
    value: t(`${shipped} sistemas · desde ${since}`, `${shipped} systems · since ${since}`),
  },
];
---

<section id="inicio" class="band">
  <div class="cols">
    {/* The margin carries the facts a recruiter checks first. */}
    <dl class="c-meta order-2 m-0 flex flex-col gap-5 min-[900px]:order-1 min-[900px]:pt-3">
      {
        annotations.map((a) => (
          <div>
            <dt class="t-meta">{a.label}</dt>
            <dd class="m-0 mt-1 text-[15px] font-medium">{a.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="c-main order-1 min-[900px]:order-2">
      <h1 class="t-display">
        <span class="mask d1"><span>Franco</span></span>{" "}
        <span class="mask d2"><span class="accent">Sanchez</span></span>
      </h1>

      <p class="t-sub mask d3 mt-8 max-w-[30ch]">
        <span>
          {
            t(
              "Sistemas que llegan al piso de producción, y se quedan.",
              "Systems that reach the production floor, and stay there.",
            )
          }
        </span>
      </p>

      <p class="t-body mask d4 mt-6">
        <span>
          {
            t(
              "Llevo sistemas de IA desde la idea hasta la operación real, y mido lo que ahorran: planta textil, facturación fiscal, trámites universitarios, reclutamiento. Cinco sistemas en producción, no demos.",
              "I take AI systems from concept to real operations, and measure what they save: textile plants, fiscal invoicing, university procedures, recruitment. Five systems in production, not demos.",
            )
          }
        </span>
      </p>

      <div class="mask d4 mt-10">
        <span class="flex flex-wrap items-center gap-3">
          <a href={profile.cvUrl} download class="act">
            {t("Descargar CV", "Download CV")}
          </a>
          <a href="#proyectos" class="act act-ghost">
            {t("Ver el registro", "See the record")}
          </a>
        </span>
      </div>

      <p class="t-meta mt-10 normal-case tracking-normal">
        {
          t(
            "Disponible para puestos de tiempo completo y proyectos por contrato.",
            "Available for full-time positions and contract projects.",
          )
        }
      </p>
    </div>
  </div>
</section>
