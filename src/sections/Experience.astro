---
import Section from "../components/Section.astro";
import { experience } from "../data/experience";
import { formatPeriod } from "../lib/dates";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section
  id="experiencia"
  class="band-ink"
  title={t("Experiencia", "Experience")}
  meta={t(`${experience.length} puestos`, `${experience.length} posts`)}
  subtitle={t(
    "Dónde he trabajado y qué quedó funcionando cuando me fui.",
    "Where I have worked, and what was still running when I left.",
  )}
>
  <ol class="m-0 list-none p-0">
    {
      experience.map((item) => (
        <li class="row">
          <div class="row-n">
            <p class="t-meta">{formatPeriod(item.period, lang)}</p>
          </div>
          <div class="row-t">
            <h3 class="t-sub">{t(item.role.es, item.role.en)}</h3>
            <p class="t-meta mt-2 normal-case tracking-normal">{item.company}</p>
            <ul class="tags mt-4">
              {(lang === "es" ? item.tags.es : item.tags.en).map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>
          <div class="row-d">
            <p class="t-body text-[0.95rem]">{t(item.description.es, item.description.en)}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
