---
import { education } from "../data/education";
import { formatPeriod } from "../lib/dates";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="educacion" class="band">
  <div class="cred-head">
    <h2 class="t-head">{t("Formación", "Training")}</h2>
    <p class="t-body">
      {
        t(
          "Ingeniería de sistemas y posgrado en inteligencia artificial. El trabajo de arriba es lo que esa formación produce.",
          "Systems engineering and graduate work in artificial intelligence. The projects above are what that training produces.",
        )
      }
    </p>
  </div>
  <ol class="cred-list">
    {
      education.map((edu) => (
        <li>
          <span class="cred-when tabular">{formatPeriod(edu.period, lang)}</span>
          <div>
            <h3>
              {t(edu.degree.es, edu.degree.en)}
              {edu.status === "in-progress" && (
                <em>{t("en curso", "in progress")}</em>
              )}
            </h3>
            <p>
              {edu.institution}
              {edu.location ? ` · ${edu.location}` : ""}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
