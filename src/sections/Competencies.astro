---
import { competencies } from "../data/competencies";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="competencias" class="band offer-band">
  <div class="offer-head">
    <h2 class="t-head">{t("Cómo trabajo", "How I work")}</h2>
    <p class="t-body">
      {
        t(
          "Tres formas de encargarme de un sistema: el modelo, el producto y la entrega.",
          "Three ways I take a system: the model, the product, and the delivery.",
        )
      }
    </p>
  </div>
  <ol class="offer-list">
    {
      competencies.map((comp, idx) => (
        <li>
          <span class="offer-n tabular">0{idx + 1}</span>
          <div>
            <h3>{t(comp.title.es, comp.title.en)}</h3>
            <p>{t(comp.description.es, comp.description.en)}</p>
            <p class="offer-tech">{comp.techs.join(" · ")}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
