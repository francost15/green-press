---
import Section from "../components/Section.astro";
import { competencies } from "../data/competencies";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section
  id="competencias"
  class="band-ink"
  title={t("Competencias", "Competencies")}
  meta={t("3 cortes", "3 cuts")}
  subtitle={t("Lo que me contratarías para resolver", "What you'd hire me to solve")}
>
  <ul class="wavy-list">
    {
      competencies.map((comp) => (
        <li class="wavy-tag">
          <p class="t-meta">{comp.techs.join(" · ")}</p>
          <h3 class="t-sub">{t(comp.title.es, comp.title.en)}</h3>
          <p class="t-body mt-2">{t(comp.description.es, comp.description.en)}</p>
        </li>
      ))
    }
  </ul>
</Section>
